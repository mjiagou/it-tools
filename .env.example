# 1. Cloudflare 账户 ID（在 Cloudflare R2 概览页右上角查看）
R2_ACCOUNT_ID=your_cloudflare_account_id

# 2. R2 API 令牌 Access Key ID（在 R2 -> 管理 R2 API 令牌 -> 创建具有“对象读写”权限的令牌后获取）
R2_ACCESS_KEY_ID=your_r2_access_key_id

# 3. R2 API 令牌 Secret Access Key
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# 4. R2 存储桶名称（Bucket Name，支持多项目共用同一个存储桶）
R2_BUCKET_NAME=r2-52-emdash-133861

# 5. R2 绑定的自定义公共访问域名（不要以 / 结尾）
R2_PUBLIC_DOMAIN=https://img.888467.xyz

# 6. 共用存储桶中的项目隔离目录前缀（上传路径格式：888467/YYYY/MM/<hash>.<ext>）
R2_KEY_PREFIX=888467

# 7. 可选：上传成功后是否自动删除本地原图文件（true / false，默认 false 保留本地原图）
R2_DELETE_LOCAL_AFTER_UPLOAD=false

# 8. 是否自动抓取并迁移 Markdown 中的第三方外链图片到 R2（true / false）
R2_AUTO_MIGRATE_REMOTE=true

